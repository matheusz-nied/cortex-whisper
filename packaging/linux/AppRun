#!/bin/sh
APPDIR="$(dirname "$(readlink -f "$0")")"

# The application ships binary dependencies from the CI build environment.
# Loading desktop GIO modules from a newer host into that process can mix
# incompatible ABIs. Cortex Whisper stores its own settings and does not need
# dconf or GVfs in the GUI process, so keep GIO local to the AppImage.
export GIO_MODULE_DIR="$APPDIR/usr/lib/cortex-whisper/gio-modules"
export GIO_USE_VFS=local
export GSETTINGS_BACKEND=memory
export CORTEX_WHISPER_APPIMAGE_GIO_ISOLATED=1

exec "$APPDIR/usr/bin/cortex-whisper" "$@"
